# Production Environment Variables Template
# Copy this file and rename it to .env.production
# Replace the placeholder values with your actual production values

# Database Configuration
DATABASE_URL="postgresql://username:password@host:port/database"

# JWT Configuration
JWT_PASSWORD="your-super-secure-jwt-secret-here"

# Node Environment
NODE_ENV=production

# Service Ports (adjust if needed)
PORT=3000  # For HTTP API
# PORT=4000  # For WebSocket Service
# PORT=3001  # For Frontend

# CORS Configuration
CORS_ORIGIN="https://your-frontend-domain.com"

# Frontend Public URLs (for Next.js)
NEXT_PUBLIC_API_URL="https://your-api-domain.com/api/v1"
NEXT_PUBLIC_WS_URL="wss://your-websocket-domain.com"

# Platform-specific Examples:

# For Render:
# NEXT_PUBLIC_API_URL="https://metaverse-api.onrender.com/api/v1"
# NEXT_PUBLIC_WS_URL="wss://metaverse-ws.onrender.com"
# CORS_ORIGIN="https://metaverse-frontend.onrender.com"

# For Railway:
# NEXT_PUBLIC_API_URL="https://your-api-service.railway.app/api/v1"
# NEXT_PUBLIC_WS_URL="wss://your-ws-service.railway.app"
# CORS_ORIGIN="https://your-frontend-service.railway.app" 