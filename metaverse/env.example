# Database
DATABASE_URL="postgresql://username:password@localhost:5432/metaverse?schema=public"

# Docker environment
DB_USER=postgres
DB_PASS=password
DB_NAME=metaverse

# JWT
JWT_SECRET="your-jwt-secret-here"

# Server Configuration
NODE_ENV=production
PORT=3000

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Application Ports
FRONTEND_PORT=3001
HTTP_API_PORT=3000
WS_SERVER_PORT=4000

# Environment
NODE_ENV=development

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000 