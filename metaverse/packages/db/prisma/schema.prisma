// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Every user can have multiple spaces
// the space will have a creator
model User {
  id       String  @id @unique @default(cuid())
  username String  @unique
  password String
  avatarId String?
  role     Role
  Space    Space[]
  avatar   Avatar?  @relation(fields: [avatarId], references: [id])
  // Team invites
  sentInvites     SpaceInvite[] @relation("Inviter")
  receivedInvites SpaceInvite[] @relation("Invitee")
}

model Space {
  id        String          @id @unique @default(cuid())
  name      String
  width     Int
  height    Int
  thumbnail String?
  creatorId String
  creator   User            @relation(fields: [creatorId], references: [id])
  elements  spaceElements[]
  invites   SpaceInvite[]
  // Map reference
  mapId     String?
  map       Map?            @relation(fields: [mapId], references: [id])
}

// Team invites for spaces
model SpaceInvite {
  id        String   @id @unique @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  inviterId String
  inviter   User     @relation("Inviter", fields: [inviterId], references: [id])
  inviteeId String
  invitee   User     @relation("Invitee", fields: [inviteeId], references: [id])
  status    InviteStatus @default(PENDING)
  createdAt DateTime @default(now())
  
  @@unique([spaceId, inviteeId])
}

model spaceElements {
  id        String  @id @unique @default(cuid())
  elementId String
  spaceId   String
  x         Int
  y         Int
  space     Space   @relation(fields: [spaceId], references: [id])
  element   Element @relation(fields: [elementId], references: [id])
}

model Element {
  id          String          @id @unique @default(cuid())
  width       Int
  height      Int
  static      Boolean
  imageUrl    String
  collisionZone String @default("full") // none, full, top, bottom, left, right, center, corners, custom
  collisionMask String? // Base64 encoded collision mask for custom patterns
  spaces      spaceElements[]
  mapElements MapElements[]
}

model Map {
  id          String        @id @unique @default(cuid())
  width       Int
  height      Int
  name        String
  thumbnail   String?
  description String?
  isPublic    Boolean       @default(false)
  creatorId   String?
  mapElements MapElements[]
  spaces      Space[]
  tiledMapFile  String?
}

model MapElements {
  id        String  @id @unique @default(cuid())
  mapId     String
  elementId String
  x         Int?
  y         Int?
  map       Map     @relation(fields: [mapId], references: [id])
  element   Element @relation(fields: [elementId], references: [id])
}

model Avatar {
  id       String  @id @unique @default(cuid())
  imageUrl String?
  name     String?
  users    User[]
}

enum Role {
  Admin
  User
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}
